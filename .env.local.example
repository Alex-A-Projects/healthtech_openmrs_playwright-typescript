# =====================================================
# Local OpenMRS Docker — copy to .env to use instead of O2
# =====================================================
# 1. Run: npm run start:openmrs   (boots MySQL + OpenMRS, waits until ready)
# 2. Copy this file: cp .env.local.example .env
# 3. Run: npm test

# UI base URL (port 8088 by default — see docker-compose.yml)
O2_BASE_URL=http://localhost:8088/openmrs

# Default admin login (works out of the box for OpenMRS Reference Application)
O2_USERNAME=admin
O2_PASSWORD=Admin123
O2_LOCATION=Inpatient Ward

# REST API — trailing slash is required for Node URL resolution
API_BASE_URL=http://localhost:8088/openmrs/ws/rest/v1/
API_SESSION_CACHE=./.api-session.json

# MySQL — exposed on localhost:3306 by the docker-compose stack
DB_HOST=localhost
DB_PORT=3306
DB_USER=openmrs
DB_PASSWORD=openmrs
DB_NAME=openmrs
DB_SKIP_IF_MISSING=false

# Tuning
ACTION_DELAY_MS=50
LOG_LEVEL=info
SKIP_GLOBAL_SETUP=false

# Cloudflare cookie not needed for local Docker — leave empty
CF_CLEARANCE=
CF_BM=

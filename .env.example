# =====================================================
# OpenMRS target
# =====================================================
# Two options:
#   1. Default: https://o2.openmrs.org (shared public demo, behind Cloudflare)
#   2. Local Docker: http://localhost:8080/openmrs (after `npm run start:openmrs`)

# UI base URL — change to http://localhost:8080/openmrs for local Docker
O2_BASE_URL=https://o2.openmrs.org/openmrs

# Default admin login (works for both O2 and local Docker)
O2_USERNAME=admin
O2_PASSWORD=Admin123
O2_LOCATION=Inpatient Ward

# =====================================================
# OpenMRS REST API
# =====================================================
# REST root for the O2 demo. v1 endpoints sit under /ws/rest/v1/
# NOTE: MUST end with a trailing slash so Node's URL constructor
# correctly resolves relative paths like "session" → ".../v1/session".
API_BASE_URL=https://o2.openmrs.org/openmrs/ws/rest/v1/

# Session token cache file (relative path) - used by the API helper
API_SESSION_CACHE=./.api-session.json

# =====================================================
# Database (LOCAL OpenMRS Docker)
# =====================================================
# O2 + OpenMRS Reference Application typically run on MySQL with these
# defaults when launched via docker-compose. Override for your local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=openmrs
DB_PASSWORD=openmrs
DB_NAME=openmrs
# Set to "true" to skip DB tests when DB env vars are missing
DB_SKIP_IF_MISSING=true

# =====================================================
# Tuning
# =====================================================
# Delay between UI actions to stay polite to the shared O2 server
ACTION_DELAY_MS=150
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Set to "true" to skip the O2 health probe in global-setup. Useful when
# Cloudflare is rate-limiting your IP (HTTP 403) — discovery still works,
# but tests that hit O2 will fail individually.
SKIP_GLOBAL_SETUP=false

# =====================================================
# Cloudflare bypass (Option A)
# =====================================================
# O2 is behind Cloudflare which blocks scripted requests with HTTP 403.
# When you manually open O2 in Chrome and pass the JS challenge, your
# browser stores a `cf_clearance` cookie valid ~24h.
#
# Copy the value from Chrome DevTools → Application → Cookies →
# https://o2.openmrs.org → cf_clearance. Paste below:
CF_CLEARANCE=
# (Optional) `__cf_bm` cookie value if you also want Bot Management bypass.
CF_BM=
